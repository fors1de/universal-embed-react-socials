{
  "name": "@fors1de/universal-embed-react-socials",
  "version": "1.2.0",
  "description": "Embed socials for React and React Native — Facebook, Instagram, LinkedIn, Pinterest, TikTok, X, and YouTube.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fors1de/universal-embed-react-socials.git"
  },
  "bugs": {
    "url": "https://github.com/fors1de/universal-embed-react-socials/issues"
  },
  "homepage": "https://github.com/fors1de/universal-embed-react-socials#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc && node scripts/flatten-web-suffix.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "react-native",
    "social",
    "media",
    "embed",
    "facebook",
    "instagram",
    "tiktok",
    "linkedin",
    "pinterest",
    "twitter",
    "x",
    "youtube"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3"
  }
}
